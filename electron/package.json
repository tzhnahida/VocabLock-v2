{
  "name": "vocablock-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VocabLock desktop shell (Electron + React) — implements docs/design/app.html",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/check-screens.mjs",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test",
    "pack": "electron-vite build && electron-builder --win dir",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.tzhnahida.vocablock",
    "productName": "VocabLock",
    "copyright": "VocabLock",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ],
      "executableName": "vocablock-desktop",
      "icon": "resources/icon.png"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
