# Compilers & toolchains (self-contained in project, never system-wide)
/go/
/node/
/flutter/
/dart/

# Dependencies
node_modules/
frontend/.dart_tool/
frontend/build/
frontend/pubspec.lock
backend/frontend/.dart_tool/
backend/frontend/build/
backend/frontend/windows/flutter/ephemeral/

# Build output
/release/
*.exe
*.exe~
*.tmp
stdout.txt
stderr.txt
build/bin/

# Secrets (never commit API keys)
.env
*.pem
*.key
backend/configs/app.yaml
backend/configs/secrets.yaml
backend/configs/convo*.yaml

# Runtime data
.dsh-ops/
*.db
data/
reports/

# Pronounce test files (not main line)
backend/pronounce-test/kit/julius.exe
backend/pronounce-test/kit/model/
backend/pronounce-test/*.wav
tmp/

# Wails v1 artifact (vestigial)
frontend/dist/
frontend/package.json.md5

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.pyc

# External bridge scripts / data (community-provided, kept locally)
backend/dict/
backend/tts/
backend/pronounce-test/

# Claude Code (never commit AI assistant config)
CLAUDE.md
.claude/

# Debug / one-off tools
backend/server_combined.txt
backend/scan_all.go
backend/scripts/_shots.sh

# OS
Thumbs.db
.DS_Store
# Root-level only: a bare "test/" also ignored backend/frontend/test/, so
# newly added Flutter tests were silently kept out of the repo.
/test/

# Test artifacts
backend/coverage.out
electron/test-results/
electron/playwright-report/
